# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env
.env.*

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# uv.lock is deliberately NOT ignored: it is committed for reproducible builds.

# Spark and Delta, when a job runs them locally
spark-warehouse/
metastore_db/
derby.log

# Claude Code runtime artifacts. .claude/agents/, .claude/hooks/, .claude/kb/ and
# .claude/settings.json are versioned.
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*~

# The job's landing directory and whatever else it writes under data/; the directory itself is
# tracked through data/.gitkeep so that Docker does not create it as root.
data/*
!data/.gitkeep
